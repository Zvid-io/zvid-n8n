          "jsCode": "const rows=$input.all().map(i=>i.json).filter(r=>r.request_key);if(rows.length!==1)throw new Error('Upsert must leave exactly one persisted request.');const row=rows[0];if(row.status!=='completed'||row.job_id!=='not-a-real-render-job'||row.quoted_credits!==0||typeof row.updated_at!=='string'||!Number.isFinite(Date.parse(row.updated_at)))throw new Error('Typed state recovery failed.');if(JSON.parse(row.input_json).synthetic!==true)throw new Error('Frozen input was not retained.');return [{json:{resource:'isolated_local_datatable_qa',dataTableId:$(\"Ensure isolated QA ledger\").first().json.id,rowId:row.id,requestKey:row.request_key,rowCount:rows.length,status:row.status,emptyLookupPassed:$(\"Verify empty lookup\").first().json.emptyLookupPassed,typedCreditsPassed:row.quoted_credits===0,dateSerializationPassed:true,storedJsonPassed:true,paidNodesExecuted:[]}}];"
