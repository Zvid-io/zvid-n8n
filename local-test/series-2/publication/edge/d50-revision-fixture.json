      {
        "id": "ZvidSeries2PubQARevisionD50-11",
        "name": "Verify r2 source and preserved r1 records",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          540,
          670
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const guard=$(\"Guard exact r1 and absent r2\").first().json;const primaryRows=$(\"Read back D50 r2 source\").all().map(item=>item.json).filter(row=>row.source_id);if(primaryRows.length!==1)throw new Error('Source readback is ambiguous');const primary=primaryRows[0],equal=(a,b)=>String(a??'')===String(b??'');for(const field of [\"source_id\",\"revision\",\"approval\",\"status\",\"source_url\",\"updated_at\",\"title\",\"deadline\",\"bidOwner\",\"automation_status\",\"request_key\",\"input_hash\",\"job_id\",\"video_url\",\"drive_file_id\",\"drive_url\",\"completed_at\",\"outcome_summary\",\"automation_error\"]){const expected=field==='revision'?'r2':field==='updated_at'?guard.newUpdatedAt:guard.originalPrimary[field];if(!equal(primary[field],expected))throw new Error('Primary readback changed '+field+' unexpectedly');}const details=$input.all().map(item=>item.json).filter(row=>row.parent_id===primary.source_id);const old=details.filter(row=>row.revision==='r1'),fresh=details.filter(row=>row.revision==='r2');if(old.length!==guard.originalDetails.length||fresh.length!==guard.newRows.length)throw new Error('Partial or duplicate revision details. Reconcile manually');const check=(actual,expected)=>{for(const wanted of expected){const matched=actual.filter(row=>row.kind===wanted.kind&&equal(row.position,wanted.position));if(matched.length!==1)throw new Error('Missing or duplicate detail position');for(const field of [\"parent_id\",\"revision\",\"kind\",\"position\",\"requirement\",\"verified\",\"name\",\"owner\",\"ready\"])if(!equal(matched[0][field],wanted[field]))throw new Error('Detail readback changed '+field);}};check(old,guard.originalDetails);check(fresh,guard.newRows);return [{json:{status:'d50_source_revision_r2_ready',sourceId:primary.source_id,revision:primary.revision,updatedAt:primary.updated_at,r1DetailsRetained:old.length,r2DetailsCreated:fresh.length,previousJobId:guard.originalPrimary.job_id,previousDriveFileId:guard.originalPrimary.drive_file_id,previousRequestKey:guard.originalPrimary.request_key,previousReceiptRetained:true,ledgerModified:false,assetsModified:false,newRenderSubmitted:false}}];"
        }
