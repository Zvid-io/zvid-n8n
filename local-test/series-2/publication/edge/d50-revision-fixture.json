        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const sources=$(\"Read current D50 source\").all().map(item=>item.json).filter(row=>row.source_id);if(sources.length!==1)throw new Error('D50 requires exactly one synthetic source; no changes made');const primary=sources[0];if(primary.source_id!==\"qa-d50-record-001\"||primary.revision!=='r1'||primary.automation_status!=='delivered'||!primary.job_id||!primary.drive_file_id||!primary.video_url||!primary.drive_url||!primary.request_key.includes('|r1|')||!primary.request_key.endsWith('|'+\"1h6oON2cyIPATUP78tgJt6LhaFr_RB3uh\"))throw new Error('Expected the exact delivered r1 QA source; no changes made');const details=$input.all().map(item=>item.json).filter(row=>row.parent_id===primary.source_id);if(details.some(row=>row.revision==='r2'))throw new Error('D50 r2 detail rows already exist: complete or partial prior run. Reconcile manually; no changes made');const previous=details.filter(row=>row.revision==='r1');if(previous.length!==5||previous.filter(row=>row.kind==='eligibility').length!==2||previous.filter(row=>row.kind==='document').length!==3)throw new Error('Expected all five existing r1 QA details');const identities=new Set(previous.map(row=>row.kind+'|'+row.position));if(identities.size!==previous.length)throw new Error('Duplicate r1 detail positions');const headers=[\"parent_id\",\"revision\",\"kind\",\"position\",\"requirement\",\"verified\",\"name\",\"owner\",\"ready\"];const rows=previous.map(row=>Object.fromEntries(headers.map(key=>[key,key==='revision'?'r2':row[key]??''])));return [{json:{originalPrimary:primary,originalDetails:previous,newRows:rows,newUpdatedAt:new Date().toISOString()}}];"
        }
