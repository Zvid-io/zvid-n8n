        "id": "create-folder",
        "name": "Create private QA video folder",
        "type": "n8n-nodes-base.googleDrive",
        "typeVersion": 3,
        "position": [
          270,
          240
        ],
        "credentials": {
          "googleDriveOAuth2Api": {
            "id": "UH2cKTIIc4ymModq",
            "name": "Google Drive account"
          }
        },
        "parameters": {
          "authentication": "oAuth2",
          "resource": "folder",
          "operation": "create",
          "name": "Zvid n8n Days 31-60 publication QA - private",
          "driveId": {
            "__rl": true,
            "mode": "list",
            "value": "My Drive"
          },
          "folderId": {
            "__rl": true,
            "mode": "list",
            "value": "root"
          },
          "options": {
            "simplifyOutput": false
          }
        }
      },
      {
        "id": "folder-evidence",
        "name": "Folder evidence",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          560,
          240
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const x=$input.first().json; if(!x.id||x.mimeType!=='application/vnd.google-apps.folder')throw new Error('QA folder creation did not return a folder ID.'); return [{json:{resource:'private_qa_folder',folderId:x.id,name:x.name,folderUrl:x.webViewLink||('https://drive.google.com/drive/folders/'+x.id),shared:x.shared===true,mimeType:x.mimeType}}];"
        }
      }
