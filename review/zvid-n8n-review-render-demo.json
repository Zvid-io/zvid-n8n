		{
			"parameters": {
				"jsCode": "const job = $input.first().json;\nconst state = String(job.state || job.status || 'unknown');\n\nif (state === 'failed') {\n  throw new Error('Render failed: ' + (job.failedReason || 'no reason given'));\n}\n\nconst maxPolls = 60;\nif ($runIndex + 1 >= maxPolls) {\n  const jobId = job.id || job.jobId || 'unknown';\n  throw new Error(`Render ${jobId} did not finish within 3 minutes (last state: ${state}).`);\n}\n\nreturn $input.all();"
			},
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [
				980,
				120
			],
			"id": "31f47eb7-554e-4d82-9afc-1af8093ebd06",
			"name": "Still rendering?"
		},
		{
			"parameters": {
				"jsCode": "const job = $input.first().json;\nconst state = String(job.state || job.status || 'unknown');\nconst result = job.result;\nconst videoUrl = typeof result === 'string'\n  ? result\n  : result && typeof result === 'object'\n    ? result.url || null\n    : job.url || null;\n\nif (state !== 'completed') {\n  throw new Error(`Expected a completed render, received state: ${state}`);\n}\nif (!videoUrl) {\n  throw new Error('Render completed but returned no video URL.');\n}\n\nreturn [{\n  json: {\n    rendered: true,\n    status: state,\n    jobId: job.id || job.jobId || null,\n    videoUrl,\n    creditsExpected: 4,\n    nextStep: 'Open videoUrl to show the completed render during the n8n review recording.',\n  },\n}];"
			},
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [
				1220,
				-60
			],
			"id": "312615f7-1e75-4b13-9f87-7fabafc28d08",
			"name": "Review render result"
		},
		{
			"parameters": {
				"jsCode": "const validation = $input.first().json;\nreturn [{\n  json: {\n    rendered: false,\n    reason: validation.error || 'Project validation failed',\n    errors: validation.errors || [],\n    warnings: validation.warnings || [],\n    nextStep: 'Fix every validation error and layout warning before rendering.',\n  },\n}];"
			},
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [
